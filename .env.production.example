# HUSIKA TTS — Production env template
# On the VPS, copy this file to /srv/husika/.env and edit values as needed.
# docker compose reads .env from the same dir as docker-compose.yml.

# Container image to run. CI/CD writes the latest commit SHA tag here on each
# successful deploy; :latest is the fallback for manual `docker compose up`.
IMAGE=ghcr.io/speedykom/husika-tts:latest

# Application log level (debug | info | warning | error)
LOG_LEVEL=info

# Path to the SQLite database inside the app container. The backup/restore
# scripts read this same value, so the DB location is defined in one place.
DB_PATH=/app/data/husika.db

# Name of the app container (Compose project "husika" -> husika-app-1). Used by
# the backup/restore scripts to exec into the running app.
CONTAINER=husika-app-1

# How many days of database backups to keep; older ones are pruned by backup.sh.
BACKUP_KEEP_DAYS=7

# Toposa VITS checkpoints (private Hugging Face repos; needs HF_TOKEN).
# JSON object: language code -> repo id, or {"repo": ..., "speaker": ...} for the
# multi-speaker model. The codes must match the entries in languages/languages.yaml.
# TOPOSA_MODELS={"toq-clear":"<org>/<clear-repo>","toq-natural":"<org>/<natural-repo>","toq-5spk":{"repo":"<org>/<5speakers-repo>","speaker":"LA"}}

# Pokot VITS checkpoints (private Hugging Face repos; needs HF_TOKEN).
# Same format as TOPOSA_MODELS. pko-p3 is the five-speaker model; "speaker" picks
# its voice (PK01-PK05, default PK01).
# POKOT_MODELS={"pko-p1":"<org>/<p1-repo>","pko-p2":"<org>/<p2-repo>","pko-p3":{"repo":"<org>/<p3-repo>","speaker":"PK03"}}

# Karamojong VITS checkpoints (private Hugging Face repos; needs HF_TOKEN).
# JSON object: language code -> repo id. The codes must match the entries in
# languages/languages.yaml. kdj-k05 is the single-speaker K05 voice.
# KARAMOJONG_MODELS={"kdj-k05":"<org>/<k05-repo>"}

# Turkana VITS checkpoints (private Hugging Face repos; needs HF_TOKEN).
# Same format as TOPOSA_MODELS. tuv-col is the 14-speaker model; "speaker" picks
# its voice (T01-T14, default T01). tuv-open has one voice (GRN).
# TURKANA_MODELS={"tuv-open":"<org>/<open-repo>","tuv-col":{"repo":"<org>/<collected-repo>","speaker":"T05"}}
